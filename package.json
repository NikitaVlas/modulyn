{
  "name": "modulyn",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @modulyn/contracts --filter @modulyn/i18n build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @modulyn/contracts --filter @modulyn/i18n build && pnpm --filter @modulyn/i18n test && pnpm --filter @modulyn/api test",
    "test:integration": "node scripts/test-integration.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "node scripts/dev.mjs",
    "env:init": "node scripts/init-env.mjs",
    "infra:up": "docker compose up -d db mailpit",
    "db:roles": "node scripts/db.mjs roles",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:setup": "node scripts/db.mjs setup",
    "db:seed": "node scripts/db.mjs seed",
    "db:drift": "node scripts/db.mjs drift",
    "db:backup": "node scripts/db.mjs backup",
    "db:restore-check": "node scripts/db.mjs restore-check",
    "db:cleanup": "node scripts/db.mjs cleanup",
    "platform:admin": "node scripts/db.mjs platform-admin",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose down",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "@types/node": "26.6.6"
  }
}
