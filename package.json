{
  "name": "modulyn",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @modulyn/contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @modulyn/contracts build && pnpm --filter @modulyn/api test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "node scripts/dev.mjs",
    "env:init": "node scripts/init-env.mjs",
    "infra:up": "docker compose up -d db",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose down",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "@types/node": "26.6.6"
  }
}
