// Modulyn — модель данных. Согласована 2026-11-16 (specs/phase2_design.md, редакция 2; specs/phase3_design.md, раздел 4).
// В этом файле только таблицы, мигрированные на текущий момент (D4):
// Phase 2 — tenants, users, memberships, platform_admins, modules, tenant_modules,
// leads, lead_status_history, tenant_audit_logs, platform_audit_logs.
// Phase 3 — user_identities, user_sessions, login_handoffs, tenant_sessions, platform_sessions, auth_throttle.
// Приём заявок (form_endpoints, form_submissions) — Phase 8.
//
// Всё, что Prisma не выражает (CHECK, RLS, политики, GRANT), — в SQL миграций.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Справочники ─────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  TENANT_ADMIN
  MANAGER
}

enum IdentityProvider {
  GOOGLE
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  CONVERTED
  CLOSED
}

enum LeadSource {
  WEB_FORM
  MANUAL
}

// ═════════════ Глобальные таблицы (без tenant_id, без RLS) ═════════════

model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique @db.VarChar(63)
  name        String       @db.VarChar(200)
  displayName String       @map("display_name") @db.VarChar(200)
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       Membership[]
  modules           TenantModule[]
  leads             Lead[]
  leadStatusHistory LeadStatusHistory[]
  auditLogs         TenantAuditLog[]
  platformAuditLogs PlatformAuditLog[]
  sessions          TenantSession[]
  loginHandoffs     LoginHandoff[]

  @@map("tenants")
}

/// Человек. Один аккаунт на все компании (D1′).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.VarChar(320)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String?   @map("password_hash")
  name            String    @db.VarChar(200)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// B8: временный пароль (выдан при создании компании) — до смены доступны только /me, /password, /logout.
  passwordChangeRequired Boolean   @default(false) @map("password_change_required")
  tempPasswordExpiresAt  DateTime? @map("temp_password_expires_at") @db.Timestamptz(3)

  memberships   Membership[]
  identities    UserIdentity[]
  sessions      UserSession[]
  loginHandoffs LoginHandoff[]

  @@map("users")
}

/// Внешний способ входа (Google). Связывает постоянный Google "sub" с аккаунтом (A12).
model UserIdentity {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(255)
  emailAtLink     String           @map("email_at_link") @db.VarChar(320)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt      DateTime?        @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("user_identities")
}

/// Сессия центрального входа (app.<домен>). Одна запись — один refresh-токен; ротация создаёт новую запись той же цепочки (familyId).
model UserSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenantSessions TenantSession[]
  loginHandoffs  LoginHandoff[]

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

/// Одноразовый код перехода с app.<домен> на поддомен компании (60 с), привязанный к браузеру через state (A6).
model LoginHandoff {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userSessionId String    @map("user_session_id") @db.Uuid
  codeHash      String    @unique @map("code_hash") @db.VarChar(128)
  stateHash     String    @map("state_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userSession UserSession @relation(fields: [userSessionId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("login_handoffs")
}

model PlatformAdmin {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash")
  name         String   @db.VarChar(200)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// B8: временный пароль от команды platform-admin — обязательная смена при первом входе.
  passwordChangeRequired Boolean   @default(false) @map("password_change_required")
  tempPasswordExpiresAt  DateTime? @map("temp_password_expires_at") @db.Timestamptz(3)
  /// B2/B10: секрет TOTP зашифрован AES-256-GCM (PLATFORM_TOTP_KEY). enabledAt = null — второй фактор не настроен.
  totpSecretEnc String?   @map("totp_secret_enc")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Номер последнего принятого 30-секундного шага: тот же код повторно не принимается.
  totpLastStep  BigInt?   @map("totp_last_step")

  auditLogs     PlatformAuditLog[]
  sessions      PlatformSession[]
  recoveryCodes PlatformRecoveryCode[]

  @@map("platform_admins")
}

/// Одноразовые коды восстановления второго фактора (B2). Только хеши.
model PlatformRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(128)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("platform_recovery_codes")
}

model PlatformSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([familyId])
  @@map("platform_sessions")
}

/// Счётчики ограничения входа (A9). Ключ — HMAC от IP или email, исходные значения не хранятся.
model AuthThrottle {
  keyHash     String   @id @map("key_hash") @db.VarChar(128)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("auth_throttle")
}

model PlatformAuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  actorAdminId   String?  @map("actor_admin_id") @db.Uuid
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  action         String   @db.VarChar(100)
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor        PlatformAdmin? @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  targetTenant Tenant?        @relation(fields: [targetTenantId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetTenantId, createdAt])
  @@map("platform_audit_logs")
}

model Module {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenants TenantModule[]

  @@map("modules")
}

// ═════════════ Данные компаний (tenant_id + RLS) ═════════════

/// Участие пользователя в компании. Цель составных FK (tenant_id, user_id).
model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedLeads Lead[]              @relation("LeadAssignee")
  statusChanges LeadStatusHistory[]
  auditLogs     TenantAuditLog[]
  sessions      TenantSession[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([tenantId, moduleId])
  @@map("tenant_modules")
}

/// Сессия внутри компании (поддомен). Действует только для своей компании; составной FK требует участия в ней.
model TenantSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  userSessionId     String    @map("user_session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership  Membership  @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict)
  userSession UserSession @relation(fields: [userSessionId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([familyId])
  @@index([userSessionId])
  @@map("tenant_sessions")
}

model Lead {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String     @db.VarChar(200)
  email        String?    @db.VarChar(320)
  phone        String?    @db.VarChar(50)
  message      String?
  source       LeadSource
  sourceDetail String?    @map("source_detail") @db.VarChar(100)
  status       LeadStatus @default(NEW)
  assignedToId String?    @map("assigned_to_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Назначение снимается записью assignedToId = null, не disconnect (иначе Prisma обнулит и tenantId).
  assignee      Membership?         @relation("LeadAssignee", fields: [tenantId, assignedToId], references: [tenantId, userId], onDelete: Restrict)
  statusHistory LeadStatusHistory[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, assignedToId])
  @@map("leads")
}

model LeadStatusHistory {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  leadId         String      @map("lead_id") @db.Uuid
  previousStatus LeadStatus? @map("previous_status")
  newStatus      LeadStatus  @map("new_status")
  changedById    String?     @map("changed_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead      Lead        @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)
  changedBy Membership? @relation(fields: [tenantId, changedById], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_status_history")
}

model TenantAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  Membership? @relation(fields: [tenantId, actorUserId], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("tenant_audit_logs")
}
