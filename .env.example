# Copy via pnpm env:init; never commit .env. Passwords are generated randomly.
# Bootstrap superuser of the local PostgreSQL container: used only by pnpm db:roles and integration tests.
POSTGRES_USER=modulyn
POSTGRES_PASSWORD=
POSTGRES_DB=modulyn
POSTGRES_PORT=5433
DATABASE_ADMIN_URL=
# Schema owner: runs migrations (pnpm db:migrate, Compose service migrate).
DB_OWNER_PASSWORD=
MIGRATION_DATABASE_URL=
# Runtime role of the API: no superuser, no BYPASSRLS, not table owner — row-level security applies.
DB_APP_PASSWORD=
DATABASE_URL=
# Company subdomains live under this domain: nova.localhost locally.
APP_BASE_DOMAIN=localhost
API_PORT=3001
NODE_ENV=development
HTTP_PORT=8080
# Phase 3 — separate random JWT signing keys per context (>= 32 chars, all different). Generated by pnpm env:init.
JWT_SECRET_TENANT=
JWT_SECRET_APP=
JWT_SECRET_PLATFORM=
# Phase 4 — AES-256-GCM key (64 hex chars) for platform admins' TOTP secrets. Losing it means every platform admin
# has to set up two-factor authentication again (pnpm platform:admin reset-2fa). Generated by pnpm env:init.
PLATFORM_TOTP_KEY=
# Public URLs used in redirects between app.<domain> and company subdomains: http://app.localhost:8080.
# http is allowed only with APP_BASE_DOMAIN=localhost; cookies are Secure and __Host- prefixed with https.
PUBLIC_SCHEME=http
PUBLIC_PORT=8080
# Phase 5 — outgoing mail (invitations, password reset). Any SMTP service: smtp://user:pass@host:587 or smtps://…:465.
# Local development: Mailpit from Compose (pnpm infra:up) catches all mail at http://localhost:8025.
SMTP_URL=smtp://127.0.0.1:1025
# Inside the Compose stack the API uses COMPOSE_SMTP_URL (default smtp://mailpit:1025).
COMPOSE_SMTP_URL=
# Sender, e.g. "Modulyn <no-reply@modulyn.app>"; the domain needs SPF/DKIM/DMARC at your mail provider.
MAIL_FROM=
# Optional Google sign-in (OAuth client "Web application" in Google Cloud Console). Empty = Google button hidden.
# Authorized redirect URI: <PUBLIC_SCHEME>://app.<APP_BASE_DOMAIN>:<PUBLIC_PORT>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
